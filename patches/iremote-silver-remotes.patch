+    private nonisolated static func transcribeWithParakeet(
+        audioPath: String,
+        workDir: String,
+        cliPath: String,
+        modelDir: String,
+        language: String
+    ) throws -> String {
+        let outputPath = "\(workDir)/parakeet.json"
