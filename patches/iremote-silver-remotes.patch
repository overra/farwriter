diff --git a/iRemote/VoiceCapture/RemoteAssistantClient.swift b/iRemote/VoiceCapture/RemoteAssistantClient.swift
new file mode 100644
index 0000000..26da35c
--- /dev/null
+++ b/iRemote/VoiceCapture/RemoteAssistantClient.swift
@@ -0,0 +1,110 @@
+import Foundation
+
+struct RemoteAssistantError: LocalizedError {
+    let message: String
+    var errorDescription: String? { message }
+}
+
+final class RemoteAssistantClient {
+    private struct Request: Encodable {
+        let transcript: String
+    }
+
+    private struct Response: Decodable {
+        let response: String?
+        let error: String?
+    }
+
+    private struct SpeechRequest: Encodable {
+        let text: String
+    }
+
+    private let endpoint: URL?
+    private let keyFile: String
+    private let ttsEndpoint: URL?
+    private let ttsCommand: String
+
+    init(environment: [String: String] = ProcessInfo.processInfo.environment) {
+        endpoint = environment["IREMOTE_ASSISTANT_URL"].flatMap(URL.init(string:))
+        keyFile = environment["IREMOTE_CLEANER_KEY_FILE"] ?? ""
+        ttsEndpoint = environment["IREMOTE_TTS_URL"].flatMap(URL.init(string:))
+        ttsCommand = environment["IREMOTE_TTS_COMMAND"] ?? ""
+    }
+
+    var isConfigured: Bool {
+        endpoint != nil && !keyFile.isEmpty
+    }
+
+    func assist(_ transcript: String) async throws -> String {
+        guard let endpoint else {
+            throw RemoteAssistantError(message: "The voice assistant bridge is not configured.")
+        }
+        let key = try String(contentsOfFile: keyFile, encoding: .utf8)
+            .trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !key.isEmpty else {
+            throw RemoteAssistantError(message: "The voice assistant key is empty.")
+        }
+
+        var request = URLRequest(url: endpoint)
+        request.httpMethod = "POST"
+        request.timeoutInterval = 95
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.setValue("Bearer \(key)", forHTTPHeaderField: "Authorization")
+        request.httpBody = try JSONEncoder().encode(Request(transcript: transcript))
+
+        let (data, response) = try await URLSession.shared.data(for: request)
+        guard let http = response as? HTTPURLResponse else {
+            throw RemoteAssistantError(message: "The voice assistant returned no HTTP response.")
+        }
+        let decoded = try JSONDecoder().decode(Response.self, from: data)
+        guard (200..<300).contains(http.statusCode),
+              let answer = decoded.response?.trimmingCharacters(in: .whitespacesAndNewlines),
+              !answer.isEmpty else {
+            throw RemoteAssistantError(
+                message: decoded.error ?? "The voice assistant failed (HTTP \(http.statusCode))."
+            )
+        }
+        return answer
+    }
+
+    func speak(_ text: String) {
+        let spokenText = String(text.prefix(600))
+        if let ttsEndpoint {
+            let keyFile = keyFile
+            Task.detached(priority: .utility) {
+                do {
+                    let key = try String(contentsOfFile: keyFile, encoding: .utf8)
+                        .trimmingCharacters(in: .whitespacesAndNewlines)
+                    guard !key.isEmpty else { return }
+                    var request = URLRequest(url: ttsEndpoint)
+                    request.httpMethod = "POST"
+                    request.timeoutInterval = 95
+                    request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+                    request.setValue("Bearer \(key)", forHTTPHeaderField: "Authorization")
+                    request.httpBody = try JSONEncoder().encode(SpeechRequest(text: spokenText))
+                    _ = try await URLSession.shared.data(for: request)
+                } catch {
+                    // Spoken feedback is optional; the overlay still carries the answer.
+                }
+            }
+            return
+        }
+
+        let command = ttsCommand
+        guard !command.isEmpty,
+              FileManager.default.isExecutableFile(atPath: command) else { return }
+        Task.detached(priority: .utility) {
+            let process = Process()
+            process.executableURL = URL(fileURLWithPath: command)
+            process.arguments = ["-q", spokenText]
+            process.standardOutput = FileHandle.nullDevice
+            process.standardError = FileHandle.nullDevice
+            do {
+                try process.run()
+                process.waitUntilExit()
+            } catch {
+                // Spoken feedback is optional; the overlay still carries the answer.
+            }
+        }
+    }
+}
