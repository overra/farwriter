     }
diff --git a/iRemote/VoiceCapture/RemoteStreamingTranscriber.swift b/iRemote/VoiceCapture/RemoteStreamingTranscriber.swift
new file mode 100644
index 0000000..ce44fe3
--- /dev/null
+++ b/iRemote/VoiceCapture/RemoteStreamingTranscriber.swift
@@ -0,0 +1,144 @@
+import AVFoundation
+import CoreML
+import FluidAudio
+import Foundation
+
+enum RemoteStreamingTranscriberError: LocalizedError {
+    case opusInitialization(Int32)
+    case opusDecode(Int32)
+    case audioBufferAllocation
+
+    var errorDescription: String? {
+        switch self {
+        case .opusInitialization(let code):
+            return "Unable to initialize streaming Opus decoder (\(code))"
+        case .opusDecode(let code):
+            return "Unable to decode streaming Opus frame (\(code))"
+        case .audioBufferAllocation:
+            return "Unable to allocate streaming audio buffer"
+        }
+    }
+}
+
+private final class RemoteOpusDecoderBox: @unchecked Sendable {
+    let pointer: OpaquePointer
+
+    init() throws {
+        var error: Int32 = 0
+        guard let pointer = remote_opus_decoder_create(&error) else {
+            throw RemoteStreamingTranscriberError.opusInitialization(error)
+        }
+        self.pointer = pointer
+    }
+
+    deinit {
+        remote_opus_decoder_destroy(pointer)
+    }
+
+    func reset() {
+        _ = remote_opus_decoder_reset(pointer)
+    }
+}
+
+/// Owns one ordered Opus → PCM → Parakeet streaming session.
+/// All audio and model state remain in memory and are actor-isolated.
+actor RemoteStreamingTranscriber {
+    private let manager: StreamingEouAsrManager
+    private let decoder: RemoteOpusDecoderBox
+    private let modelDirectory: URL
+    private let onPartial: @Sendable (String) -> Void
+    private let format: AVAudioFormat
+    private var active = false
+    private var consecutiveDecodeFailures = 0
+
+    init(modelDirectory: URL, onPartial: @escaping @Sendable (String) -> Void) throws {
+        guard let format = AVAudioFormat(
+            commonFormat: .pcmFormatFloat32,
+            sampleRate: 16_000,
+            channels: 1,
+            interleaved: false
+        ) else {
+            throw RemoteStreamingTranscriberError.audioBufferAllocation
+        }
+        self.format = format
+        self.modelDirectory = modelDirectory
+        self.onPartial = onPartial
+        self.decoder = try RemoteOpusDecoderBox()
+
+        let configuration = MLModelConfiguration()
+        configuration.computeUnits = .all
+        self.manager = StreamingEouAsrManager(
+            configuration: configuration,
+            chunkSize: .ms160,
+            eouDebounceMs: 1_280
+        )
+    }
+
+    func load() async throws {
+        try await manager.loadModels(from: modelDirectory)
+        await manager.setPartialCallback { [onPartial] transcript in
+            onPartial(transcript)
+        }
+    }
+
+    func begin() async {
+        decoder.reset()
+        consecutiveDecodeFailures = 0
+        active = true
+        await manager.reset()
+    }
+
+    func append(opusFrame: Data) async throws {
+        guard active else { return }
+
+        var samples = [Float](repeating: 0, count: 1_920)
+        let decoded: Int32 = opusFrame.withUnsafeBytes { bytes in
+            guard let baseAddress = bytes.bindMemory(to: UInt8.self).baseAddress else {
+                return -1
+            }
+            return remote_opus_decoder_decode(
+                decoder.pointer,
+                baseAddress,
+                Int32(opusFrame.count),
+                &samples,
+                Int32(samples.count)
+            )
+        }
+
+        guard decoded > 0 else {
+            consecutiveDecodeFailures += 1
+            if consecutiveDecodeFailures >= 5 {
+                throw RemoteStreamingTranscriberError.opusDecode(decoded)
+            }
+            return
+        }
+        consecutiveDecodeFailures = 0
+
+        guard let buffer = AVAudioPCMBuffer(
+            pcmFormat: format,
+            frameCapacity: AVAudioFrameCount(decoded)
+        ), let channel = buffer.floatChannelData?[0] else {
+            throw RemoteStreamingTranscriberError.audioBufferAllocation
+        }
+        buffer.frameLength = AVAudioFrameCount(decoded)
+        samples.withUnsafeBufferPointer { source in
+            channel.update(from: source.baseAddress!, count: Int(decoded))
+        }
+        _ = try await manager.process(audioBuffer: buffer)
+    }
+
+    func finish() async throws -> String {
+        guard active else { return "" }
+        active = false
+        let transcript = try await manager.finish()
+        decoder.reset()
+        return transcript.trimmingCharacters(in: .whitespacesAndNewlines)
+    }
+
+    func cancel() async {
+        active = false
+        decoder.reset()
+        consecutiveDecodeFailures = 0
+        await manager.reset()
+    }
+}
