diff --git a/iRemote/VoiceCapture/RemoteOpusDecoder.c b/iRemote/VoiceCapture/RemoteOpusDecoder.c
new file mode 100644
index 0000000..81c73fe
--- /dev/null
+++ b/iRemote/VoiceCapture/RemoteOpusDecoder.c
@@ -0,0 +1,80 @@
+#include "RemoteOpusDecoder.h"
+
+#include <opus/opus.h>
+#include <stdlib.h>
+
+struct RemoteOpusDecoder {
+    OpusDecoder *opus;
+};
+
+RemoteOpusDecoder *remote_opus_decoder_create(int32_t *error_code) {
+    int error = OPUS_OK;
+    OpusDecoder *opus = opus_decoder_create(16000, 1, &error);
+    if (error_code != NULL) {
+        *error_code = error;
+    }
+    if (opus == NULL || error != OPUS_OK) {
+        if (opus != NULL) {
+            opus_decoder_destroy(opus);
+        }
+        return NULL;
+    }
+
+    RemoteOpusDecoder *decoder = calloc(1, sizeof(RemoteOpusDecoder));
+    if (decoder == NULL) {
+        opus_decoder_destroy(opus);
+        if (error_code != NULL) {
+            *error_code = OPUS_ALLOC_FAIL;
+        }
+        return NULL;
+    }
+    decoder->opus = opus;
+    return decoder;
+}
+
+void remote_opus_decoder_destroy(RemoteOpusDecoder *decoder) {
+    if (decoder == NULL) {
+        return;
+    }
+    if (decoder->opus != NULL) {
+        opus_decoder_destroy(decoder->opus);
+    }
+    free(decoder);
+}
+
+int32_t remote_opus_decoder_reset(RemoteOpusDecoder *decoder) {
+    if (decoder == NULL || decoder->opus == NULL) {
+        return OPUS_BAD_ARG;
+    }
+    return opus_decoder_ctl(decoder->opus, OPUS_RESET_STATE);
+}
+
+int32_t remote_opus_decoder_decode(
+    RemoteOpusDecoder *decoder,
+    const uint8_t *packet,
+    int32_t packet_length,
+    float *pcm,
+    int32_t pcm_capacity
+) {
+    if (decoder == NULL || decoder->opus == NULL || packet == NULL ||
+        packet_length <= 0 || pcm == NULL || pcm_capacity <= 0) {
+        return OPUS_BAD_ARG;
+    }
+
+    int samples = opus_packet_get_nb_samples(packet, packet_length, 16000);
+    if (samples < 0) {
+        return samples;
+    }
+    if (samples > pcm_capacity) {
+        return OPUS_BUFFER_TOO_SMALL;
+    }
+
+    return opus_decode_float(
+        decoder->opus,
+        packet,
+        packet_length,
+        pcm,
+        pcm_capacity,
+        0
+    );
+}
