+    /// A2540/A2854 notifications use a shorter wrapper than the glass remote:
+    /// two unknown bytes, a little-endian sequence, one Opus length byte, then
+    /// a 48 kHz mono CELT frame whose TOC byte is 0xB8.
+    private func parseModernVoiceFrame(_ value: Data, onFrame: (Data) -> Void) {
+        guard value.count >= 7 else { return }
+        let opusLength = Int(value[value.startIndex + 4])
+        let payloadStart = value.startIndex + 5
+        let packetEnd = payloadStart + opusLength
+        guard opusLength >= 2,
+              packetEnd <= value.endIndex,
+              value[payloadStart] == 0xB8 else { return }
+        onFrame(value.subdata(in: payloadStart..<packetEnd))
+    }
