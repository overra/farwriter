+            cliPath,
+            arguments: [
+                "transcribe", audioPath,
+                "--model-version", "v3",
+                "--model-dir", modelDir,
+                "--language", language == "auto" ? "en" : language,
+                "--output-json", outputPath,
+            ]
+        )
+        let data = try Data(contentsOf: URL(fileURLWithPath: outputPath))
+        guard let object = try JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let text = object["text"] as? String,
+              !text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
+            throw RemoteDictationServiceError.emptyTranscript("Parakeet produced no transcript")
+        }
+        return text
+    }
+
+    private nonisolated static func cleanTranscriptWithLocalModel(
+        _ transcript: String,
+        workDir: String,
+        cleanerURL: String,
+        keyFile: String,
+        audioPath: String?
+    ) -> (text: String, mode: String?) {
+        guard !cleanerURL.isEmpty,
+              FileManager.default.fileExists(atPath: keyFile),
+              let key = try? String(contentsOfFile: keyFile, encoding: .utf8)
